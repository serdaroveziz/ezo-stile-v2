{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('businessId').val() === data.child('businessId').val())",
        ".write": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin')",
        "role": {
          ".validate": "newData.val() === 'customer' || root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
        },
        "businessId": {
          ".validate": "!newData.exists() || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'owner'"
        },
        "aiCredits": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
        },
        "welcomeAiBonusGranted": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
        }
      }
    },
    "businesses": {
      "$businessId": {
        ".read": "true",
        ".write": "auth != null && (data.child('ownerUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || (!data.exists() && root.child('users').child(auth.uid).child('role').val() === 'super_admin'))",
        "plan": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
        },
        "planStatus": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
        },
        "staffLimit": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
        },
        "averageRating": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
        }
      }
    },
    "salon_applications": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
      "$appId": {
        ".read": "auth != null && (data.child('applicantUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin')",
        ".write": "auth != null && (!data.exists() || data.child('applicantUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin')",
        "status": {
          ".validate": "newData.val() === 'pending' || root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
        }
      }
    },
    "appointments": {
      ".read": "auth != null",
      "$aptId": {
        ".read": "auth != null && (data.child('customerUid').val() === auth.uid || root.child('users').child(auth.uid).child('businessId').val() === data.child('businessId').val() || root.child('users').child(auth.uid).child('role').val() === 'super_admin')",
        ".write": "auth != null && (newData.child('customerUid').val() === auth.uid || root.child('users').child(auth.uid).child('businessId').val() === data.child('businessId').val() || root.child('users').child(auth.uid).child('role').val() === 'super_admin')"
      }
    },
    "reviews": {
      ".read": "true",
      "$reviewId": {
        ".write": "auth != null && (newData.child('customerUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin')"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin')",
        ".write": "auth != null"
      }
    },
    "ai_generations": {
      ".read": "auth != null",
      "$genId": {
        ".write": "auth != null"
      }
    },
    "audit_logs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
    }
  }
}