      ".read": "auth != null && root.child('users').child(auth.uid).exists() && root.child('users').child(auth.uid).child('disabled').val() !== true && root.child('users').child(auth.uid).child('status').val() !== 'disabled' && (root.child('users').child(auth.uid).child('role').val() === 'super_admin' || (query.orderByChild === 'customerUid' && query.equalTo === auth.uid) || (root.child('users').child(auth.uid).child('role').val() === 'owner' && root.child('users').child(auth.uid).child('businessId').isString() && root.child('businesses').child(root.child('users').child(auth.uid).child('businessId').val()).child('ownerUid').val() === auth.uid && query.orderByChild === 'businessId' && query.equalTo === root.child('users').child(auth.uid).child('businessId').val()))",
      "$aptId": {
        ".read": "auth != null && root.child('users').child(auth.uid).exists() && root.child('users').child(auth.uid).child('disabled').val() !== true && root.child('users').child(auth.uid).child('status').val() !== 'disabled' && (root.child('users').child(auth.uid).child('role').val() === 'super_admin' || data.child('customerUid').val() === auth.uid || (root.child('users').child(auth.uid).child('role').val() === 'owner' && root.child('users').child(auth.uid).child('businessId').isString() && root.child('businesses').child(root.child('users').child(auth.uid).child('businessId').val()).child('ownerUid').val() === auth.uid && data.child('businessId').val() === root.child('users').child(auth.uid).child('businessId').val()))",
        ".write": false
      }
    },
    "reviews": {
      ".indexOn": [
        "businessId"
      ],
      ".read": "auth != null && root.child('users').child(auth.uid).exists() && root.child('users').child(auth.uid).child('disabled').val() !== true && root.child('users').child(auth.uid).child('status').val() !== 'disabled' && root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
      "$reviewId": {
